# Life Buddy Mobile - Environment (example)
# Copy to .env and set for your environment. NEVER commit real secrets.
# Base URL must point to the running Life Buddy backend (includes /api/v1 if you prefer, or set without it and app appends).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Notes:
# - Android Emulator (default): http://10.0.2.2:4000  (maps to host machine localhost)
# - iOS Simulator: http://localhost:4000
# - Physical Android/iOS device on same Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:4000 (e.g. http://192.168.1.50:4000)
#   Ensure backend listens on 0.0.0.0/all interfaces and firewall allows inbound connections on the port.
# - Localhost on development computer refers to the computer itself, not the phone/emulator.
