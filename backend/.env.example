# Life Buddy Backend - Environment Variables (example only)
# Copy to .env and fill with your local values. NEVER commit real secrets.

NODE_ENV=development
PORT=4000

# MySQL (authoritative database: lifebuddy_db)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=lifebuddy_db

# JWT (use a long random secret in real use)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Security / rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Bcrypt
BCRYPT_SALT_ROUNDS=10
